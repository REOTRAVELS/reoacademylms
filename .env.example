# Copy these settings to server/.env and replace credential placeholders.
NODE_ENV=development
PORT=5000
DATABASE_URL=REPLACE_WITH_LOCAL_POSTGRES_CONNECTION_STRING
JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d
COOKIE_NAME=reoa_session
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=2048
ATTENDANCE_THRESHOLD_PERCENT=75

# Local uploads use disk. Production must use private S3-compatible storage.
FILE_STORAGE_PROVIDER=local

# For serverless hosting, use Brevo's HTTPS API and verify the sender.
BREVO_API_KEY=REPLACE_WITH_BREVO_API_KEY
EMAIL_FROM=Reotravelsacademy <info.academy@reotravelsandtours.org>
SMTP_URL=
SMTP_FROM=

# Required on Vercel for shared classroom realtime state.
REDIS_URL=REPLACE_WITH_UPSTASH_TLS_REDISS_URL

# Development-only seed passwords; never reuse these in production.
SEED_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_DEV_PASSWORD
SEED_TRAINER_PASSWORD=REPLACE_WITH_UNIQUE_DEV_PASSWORD
SEED_STUDENT_PASSWORD=REPLACE_WITH_UNIQUE_DEV_PASSWORD
SEED_PENDING_PASSWORD=REPLACE_WITH_UNIQUE_DEV_PASSWORD

# LiveKit service URL and API credentials.
LIVEKIT_URL=wss://REPLACE_WITH_LIVEKIT_PROJECT_HOST
LIVEKIT_API_KEY=REPLACE_WITH_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_LIVEKIT_API_SECRET

# Private S3-compatible bucket credentials for recordings and app uploads.
LIVEKIT_RECORDING_S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET_NAME
LIVEKIT_RECORDING_S3_REGION=us-east-005
LIVEKIT_RECORDING_S3_ACCESS_KEY=REPLACE_WITH_BUCKET_RESTRICTED_ACCESS_KEY_ID
LIVEKIT_RECORDING_S3_SECRET=REPLACE_WITH_BUCKET_RESTRICTED_ACCESS_KEY_SECRET
LIVEKIT_RECORDING_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
LIVEKIT_RECORDING_S3_PLAYBACK_ENDPOINT=https://s3.us-east-005.backblazeb2.com
LIVEKIT_RECORDING_S3_FORCE_PATH_STYLE=false

# Copy this client setting to client/.env.
VITE_API_BASE_URL=http://localhost:5000/api
